<UserControl x:Class="BookSmith.UI.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Card 1: File Selection -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Audiobook PDF File" Style="{StaticResource SectionHeaderStyle}" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="True" 
                                 Padding="8,6" 
                                 Background="#121215" 
                                 Foreground="{StaticResource TextPrimaryBrush}" 
                                 BorderBrush="{StaticResource BorderBrush}"/>

                        <Button Grid.Column="2" 
                                Content="Browse" 
                                Command="{Binding BrowseCommand}" 
                                Width="90" 
                                Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <!-- File Details (Visible when file selected) -->
                    <Grid Margin="0,4,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFileSelected}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="File Name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="File Size" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding FileSize, StringFormat={}{0:F1} KB}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Pages" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding PageCount, StringFormat={}{0} pages}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 2: Cleaning Options -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Cleaning Options" Style="{StaticResource SectionHeaderStyle}" />

                    <UniformGrid Columns="2">
                        <CheckBox Content="Remove Headers" IsChecked="{Binding RemoveHeaders}" Margin="0,4,8,4" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Remove Footers" IsChecked="{Binding RemoveFooters}" Margin="0,4,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Remove Page Numbers" IsChecked="{Binding RemovePageNumbers}" Margin="0,4,8,4" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Fix Broken Words" IsChecked="{Binding FixBrokenWords}" Margin="0,4,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Merge Wrapped Lines" IsChecked="{Binding MergeWrappedLines}" Margin="0,4,8,4" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Smart Dialogue Formatting" IsChecked="{Binding SmartDialogueFormatting}" Margin="0,4,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="ElevenReader TTS Mode" IsChecked="{Binding ElevenReaderMode}" Margin="0,4,8,4" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                        <CheckBox Content="Auto-Export EPUB" IsChecked="{Binding ExportEpub}" Margin="0,4,0,4" Foreground="{StaticResource TextPrimaryBrush}" />
                        <CheckBox Content="Remove Front Matter (Publisher credits, ISBN, copyright)" IsChecked="{Binding RemoveFrontMatter}" Margin="0,4,8,4" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Card 3: First Page Preview -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="First Page Preview" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBox Text="{Binding PreviewText, Mode=OneWay}" 
                             IsReadOnly="True" 
                             Height="110" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" 
                             Background="#121215"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8" />
                </StackPanel>
            </Border>

            <!-- Start Cleaning Action Button -->
            <Button Content="Next: Start Cleaning"
                    Command="{Binding StartCleaningCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="44"
                    FontSize="15"
                    FontWeight="Bold" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
