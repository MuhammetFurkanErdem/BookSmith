<UserControl x:Class="BookSmith.UI.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header / Back Action Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="← Back to Import" Command="{Binding BackCommand}" Height="32" Padding="12,0"/>
            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 1: Results Statistics Card -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Original Chars -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Original" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding OriginalCharCount, StringFormat={}{0:N0}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                <!-- Cleaned Chars -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Cleaned" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding CleanedCharCount, StringFormat={}{0:N0}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>

                <Border Grid.Column="3" Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                <!-- Reduction % -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Reduction" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding ReductionPercentage, StringFormat={}{0:F1}%}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                </StackPanel>

                <Border Grid.Column="5" Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                <!-- Words -->
                <StackPanel Grid.Column="6">
                    <TextBlock Text="Words" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding WordCount, StringFormat={}{0:N0}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>

                <Border Grid.Column="7" Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                <!-- Lines -->
                <StackPanel Grid.Column="8">
                    <TextBlock Text="Lines" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding LineCount, StringFormat={}{0:N0}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Quick-Action Toolbar -->
        <Border Grid.Row="2" Background="#1A1A22" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🔍 Search &amp; Replace" Command="{Binding ToggleSearchCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Search &amp; Replace (Ctrl+F)"/>

                <Button Grid.Column="2" Content="✂ Remove Selection" Command="{Binding RemoveSelectedLinesCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Remove Selected Lines"/>

                <Button Grid.Column="4" Content="↩ Undo" Command="{Binding UndoCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Undo Edit (Ctrl+Z)"/>

                <Button Grid.Column="6" Content="↪ Redo" Command="{Binding RedoCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Redo Edit (Ctrl+Y)"/>

                <Button Grid.Column="8" Content="{Binding SpellCheckStatusText}" Command="{Binding ToggleSpellCheckCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Toggle Live Spell Check ON/OFF"
                        Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>

                <Button Grid.Column="10" Content="Next Anomaly ➔" Command="{Binding JumpToNextAnomalyCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Jump to Next Detected Anomaly/Typo"
                        Style="{StaticResource PrimaryButtonStyle}"/>

                <Button Grid.Column="12" Content="🤖 AI Fix Selection" Command="{Binding AiFixSelectionCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Use LLM AI to contextually repair selection/paragraph"
                        Background="#2A1B3D" Foreground="#D19FFE" BorderBrush="#8E44AD" FontWeight="Bold"/>

                <Button Grid.Column="14" Content="⚙ AI Settings" Command="{Binding ToggleAiPanelCommand}" 
                        Padding="10,4" FontSize="12" Height="28" VerticalAlignment="Center" ToolTip="Configure LLM Endpoint (Ollama / OpenAI / Gemini)"/>
            </Grid>
        </Border>

        <!-- Row 3: Search & Replace Panel (Conditional Visibility) -->
        <Border Grid.Row="3" Background="#1E1E28" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearchPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Row -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Search:" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="6,4" FontSize="12" Background="#121215" Foreground="{StaticResource TextPrimaryBrush}" 
                             BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Find Next" Command="{Binding FindNextCommand}" 
                            Padding="8,4" FontSize="11" Height="26"/>
                    <TextBlock Grid.Column="5" Text="{Binding SearchDisplayText}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" MinWidth="60"/>
                    <Button Grid.Column="7" Content="✕" Command="{Binding ToggleSearchCommand}" 
                            Padding="6,2" FontSize="12" Height="24" Width="24" 
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>

                <!-- Replace Row -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Replace:" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ReplaceQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="6,4" FontSize="12" Background="#121215" Foreground="{StaticResource TextPrimaryBrush}" 
                             BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" Content="Replace" Command="{Binding ReplaceCurrentCommand}" 
                            Padding="8,4" FontSize="11" Height="26"/>
                    <Button Grid.Column="5" Content="Replace All" Command="{Binding ReplaceAllCommand}" 
                            Padding="8,4" FontSize="11" Height="26" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 4: Full-Screen Interactive Cleaned Text Editor -->
        <!-- Row 4: Chapter Sidebar + Editor -->
        <Grid Grid.Row="4" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Chapter sidebar: visible only when chapters exist -->
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasChapters}" Value="True">
                                    <Setter Property="Width" Value="200"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Chapter Sidebar -->
            <Border Grid.Column="0" Background="#16161E" CornerRadius="8" Padding="0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasChapters, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <!-- Sidebar header -->
                    <Border DockPanel.Dock="Top" Background="#1E1E2E" CornerRadius="8,8,0,0" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📖" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Chapters" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding Chapters.Count, StringFormat=' ({0})'}"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Chapter list -->
                    <ListBox Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding Chapters}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#22244A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.JumpToChapterCommand,
                                                  RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Padding="10,7" Cursor="Hand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Index, StringFormat='Ch. {0}'}"
                                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="11"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor TextBox -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Interactive Editor — Edit text before exporting"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="EditorTextBox"
                         Text="{Binding CleanedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         IsReadOnly="False" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Disabled"
                         Background="#121215"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="12" 
                         FontSize="13"
                         FontFamily="Consolas, Segoe UI, sans-serif"
                         SelectionChanged="EditorTextBox_SelectionChanged"
                         ContextMenuOpening="EditorTextBox_ContextMenuOpening"/>
            </DockPanel>
        </Grid>

        <!-- Row 5: EPUB Customization Panel (Conditional Visibility) -->
        <Border Grid.Row="5" Background="#1E1E28" CornerRadius="6" Padding="14,10" Margin="0,0,0,10"
                BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEpubPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <!-- Column 0: Cover Image Selection -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Book Cover Image" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CoverImagePath, Mode=OneWay}" IsReadOnly="True"
                                 Padding="6,4" FontSize="11" Background="#121215" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Browse Image" Command="{Binding SelectCoverCommand}"
                                Padding="8,4" FontSize="11" Height="26"/>
                        <Button Grid.Column="4" Content="✕" Command="{Binding ClearCoverCommand}"
                                Padding="6,2" FontSize="11" Height="26" Width="26"
                                Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>
                </StackPanel>

                <!-- Column 2: Author Metadata -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Author Name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding AuthorName, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="11" Background="#121215" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Column 4: Font Size -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Font Size (pt)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FontSizePt, UpdateSourceTrigger=PropertyChanged}"
                             Padding="6,4" FontSize="11" Background="#121215" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 3.5: AI Settings Panel (Conditional Visibility) -->
        <Border Grid.Row="3" Background="#1E1E28" CornerRadius="6" Padding="12,10" Margin="0,0,0,8"
                BorderBrush="#8E44AD" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAiPanelVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="AI Endpoint:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="2" Text="{Binding AiConfig.EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="11" Background="#121215" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <TextBlock Grid.Column="4" Text="Model Name:" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="6" Text="{Binding AiConfig.ModelName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="6,4" FontSize="11" Background="#121215" Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"/>

                <Button Grid.Column="8" Content="Test Connection" Command="{Binding TestAiConnectionCommand}"
                        Padding="10,4" FontSize="11" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="9" Text="{Binding AiStatusText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                           FontSize="11" Foreground="#D19FFE" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Row 6: Export Actions Bar -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Content="Export as EPUB"
                    Command="{Binding ExportEpubCommand}"
                    Height="42"
                    FontSize="14"
                    FontWeight="Bold"
                    Style="{StaticResource PrimaryButtonStyle}" />

            <Button Grid.Column="2"
                    Content="⚙ EPUB Settings"
                    Command="{Binding ToggleEpubPanelCommand}"
                    Height="42"
                    FontSize="12" />

            <Button Grid.Column="4"
                    Content="Export as TXT"
                    Command="{Binding ExportTxtCommand}"
                    Height="42"
                    FontSize="14" />
        </Grid>

        <!-- Overlay: Side-by-Side Diff Comparison View Modal -->
        <Grid Grid.RowSpan="7" Background="#C0000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDiffModalVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#1E1E28" CornerRadius="10" Padding="20" Margin="40"
                    BorderBrush="#8E44AD" BorderThickness="2" VerticalAlignment="Center" MaxHeight="600">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="🤖 AI Contextual Restoration — Review Changes"
                               FontSize="16" FontWeight="Bold" Foreground="#D19FFE" Margin="0,0,0,16"/>

                    <!-- Side-by-Side Comparison -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Original -->
                        <Border Grid.Column="0" Background="#2B1518" CornerRadius="6" Padding="12" BorderBrush="#E74C3C" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="❌ Original Corrupted Text" FontWeight="Bold" Foreground="#E74C3C" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding OriginalDiffText}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="Transparent" Foreground="#FADBD8" BorderThickness="0" FontSize="13"/>
                            </DockPanel>
                        </Border>

                        <!-- Right: AI Restored -->
                        <Border Grid.Column="2" Background="#152B1E" CornerRadius="6" Padding="12" BorderBrush="#2ECC71" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="✔ 🤖 AI Restored Clean Text" FontWeight="Bold" Foreground="#2ECC71" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding AiRestoredDiffText, Mode=TwoWay}" IsReadOnly="False" TextWrapping="Wrap" AcceptsReturn="True"
                                         Background="Transparent" Foreground="#D4EFDF" BorderThickness="0" FontSize="13"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Footer Actions -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ Reject" Command="{Binding RejectAiFixCommand}"
                                Padding="16,8" FontSize="13" Margin="0,0,12,0"/>
                        <Button Content="✔ Accept &amp; Replace" Command="{Binding AcceptAiFixCommand}"
                                Padding="20,8" FontSize="13" FontWeight="Bold" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
