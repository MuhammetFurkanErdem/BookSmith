<UserControl x:Class="BookSmith.UI.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainVm="clr-namespace:BookSmith.UI.ViewModels.Main"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="500"
             Background="Transparent">

    <UserControl.DataContext>
        <mainVm:MainViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: Header (Title & Subtitle) -->
            <RowDefinition Height="Auto" />
            <!-- 1: PDF File Selection -->
            <RowDefinition Height="Auto" />
            <!-- 2: Cleaning Options -->
            <RowDefinition Height="*" />
            <!-- 3: Progress & Status -->
            <RowDefinition Height="Auto" />
            <!-- 4: Action Button -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="BookSmith"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       FontFamily="{StaticResource MainFontFamily}" />
            <TextBlock Text="AI Book Cleaner for Audiobooks"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="{StaticResource MainFontFamily}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- PDF File Section -->
        <Border Grid.Row="1"
                Background="{StaticResource BgContainerBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Audiobook PDF File"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0"
                             Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True"
                             Margin="0,0,10,0"
                             Height="38"
                             VerticalContentAlignment="Center" />
                    
                    <Button Grid.Column="1"
                            Content="Browse"
                            Command="{Binding BrowseCommand}"
                            Height="38"
                            Padding="20,0" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Cleaning Options Section -->
        <Border Grid.Row="2"
                Background="{StaticResource BgContainerBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Cleaning Options"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,16" />
                
                <UniformGrid Columns="2" Rows="4" VerticalAlignment="Top">
                    <CheckBox Content="Remove headers"
                              IsChecked="{Binding RemoveHeaders}"
                              Margin="0,6,10,6" />
                    <CheckBox Content="Merge wrapped lines"
                              IsChecked="{Binding MergeWrappedLines}"
                              Margin="10,6,0,6" />
                    
                    <CheckBox Content="Remove footers"
                              IsChecked="{Binding RemoveFooters}"
                              Margin="0,6,10,6" />
                    <CheckBox Content="Smart dialogue formatting"
                              IsChecked="{Binding SmartDialogueFormatting}"
                              Margin="10,6,0,6" />
                    
                    <CheckBox Content="Remove page numbers"
                              IsChecked="{Binding RemovePageNumbers}"
                              Margin="0,6,10,6" />
                    <CheckBox Content="ElevenReader mode"
                              IsChecked="{Binding ElevenReaderMode}"
                              Margin="10,6,0,6" />
                    
                    <CheckBox Content="Fix broken words"
                              IsChecked="{Binding FixBrokenWords}"
                              Margin="0,6,10,6" />
                    <CheckBox Content="Export EPUB"
                              IsChecked="{Binding ExportEpub}"
                              Margin="10,6,0,6" />
                </UniformGrid>
            </DockPanel>
        </Border>

        <!-- Progress Section -->
        <Border Grid.Row="3"
                Background="{StaticResource BgContainerBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="Status: "
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusText}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                    
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressValue, StringFormat={}{0:0}%}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
                
                <ProgressBar Value="{Binding ProgressValue}"
                             Maximum="100"
                             Height="10" />
            </StackPanel>
        </Border>

        <!-- Large Action Button -->
        <Button Grid.Row="4"
                Content="Start Cleaning"
                Command="{Binding StartCleaningCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Height="48"
                FontSize="15" />
    </Grid>
</UserControl>
