############################################
# BookSmith - .NET / WPF Git Ignore
############################################

# Build output
**/bin/
**/obj/

# Visual Studio
.vs/

# VS Code
.vscode/

# Rider
.idea/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Temporary WPF project files
*_wpftmp.csproj
*.wpftmp

# NuGet
packages/

# Logs
*.log

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Publish output
publish/

# Test Results
TestResults/

# Coverage
coverage/
*.coverage

# Local settings (future)
appsettings.Development.json